							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Login returns 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const response = pm.response.json();",
									"",
									"pm.test(\"Login response includes token\", function () {",
									"    pm.expect(response.token).to.be.a(\"string\").and.not.empty;",
									"});",
									"",
									"pm.test(\"Login response type is Bearer\", function () {",
									"    pm.expect(response.type).to.eql(\"Bearer\");",
									"});",
									"",
									"pm.collectionVariables.set(\"token\", response.token);",
									""
